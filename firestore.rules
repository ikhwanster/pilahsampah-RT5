rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All (as a safety fallback for any unexpected paths)
    match /{document=**} {
      allow read, write: if false;
    }

    // Since our React frontend client never communicates with Firestore directly,
    // and all operations are proxied through our secure backend Express server,
    // the backend server serves as our single source of truth and security gate.
    // We allow read/write access here so our backend server (which runs unauthenticated)
    // can successfully read and write to all collections.

    match /users/{userId} {
      allow read, write: if true;
    }

    match /deposits/{depositId} {
      allow read, write: if true;
    }

    match /rewards/{rewardId} {
      allow read, write: if true;
    }

    match /claims/{claimId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
