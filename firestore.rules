rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'u-admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'username', 'role', 'address', 'phone', 'points', 'totalTrashWeight', 'createdAt', 'passwordHash']) 
        && data.keys().size() == 10
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.username is string && data.username.size() <= 50
        && data.role in ['admin', 'citizen']
        && data.address is string && data.address.size() <= 500
        && data.phone is string && data.phone.size() <= 50
        && data.points is int && data.points >= 0
        && (data.totalTrashWeight is int || data.totalTrashWeight is float) && data.totalTrashWeight >= 0.0
        && data.createdAt is string
        && data.passwordHash is string;
    }

    function isValidDeposit(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'category', 'weight', 'pointsEarned', 'date', 'status', 'createdAt'])
        && data.keys().size() <= 11 // allowed optional approvedAt
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.category in ['organic', 'plastic', 'paper', 'metal', 'glass', 'other']
        && (data.weight is int || data.weight is float) && data.weight > 0.0
        && data.pointsEarned is int && data.pointsEarned >= 0
        && data.date is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is string;
    }

    function isValidClaim(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'rewardId', 'rewardTitle', 'pointsCost', 'status', 'claimedAt'])
        && data.keys().size() == 8
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.rewardId is string && data.rewardId.size() <= 128
        && data.rewardTitle is string && data.rewardTitle.size() <= 200
        && data.pointsCost is int && data.pointsCost >= 0
        && data.status in ['pending', 'completed']
        && data.claimedAt is string;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'rating', 'comment', 'serviceType', 'createdAt'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000
        && data.serviceType in ['pickup', 'cleanliness', 'app']
        && data.createdAt is string;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['id', 'day', 'time', 'category'])
        && data.keys().size() <= 5 // optional notes
        && data.id is string && data.id.size() <= 128
        && data.day is string && data.day.size() <= 50
        && data.time is string && data.time.size() <= 100
        && data.category is string && data.category.size() <= 200;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'message', 'type', 'isRead', 'createdAt'])
        && data.keys().size() == 6
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.message is string && data.message.size() <= 1000
        && data.type in ['points_earned', 'reward_status', 'schedule_reminder', 'general']
        && data.isRead is bool
        && data.createdAt is string;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && (
        (incoming().role == 'citizen' && isOwner(userId)) || 
        isAdmin()
      );
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || 
        (isOwner(userId) && (
          // Prevent standard users from modifying their own roles or points balance
          incoming().role == existing().role && 
          incoming().points == existing().points && 
          incoming().totalTrashWeight == existing().totalTrashWeight &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'passwordHash'])
        ))
      );
      allow delete: if isAdmin();
    }

    // 2. Deposits Collection
    match /deposits/{depositId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidDeposit(incoming()) && (
        (incoming().userId == request.auth.uid && incoming().status == 'pending') || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() && isValidDeposit(incoming()) && (
          // Admin approves or rejects pending deposit
          existing().status == 'pending' && 
          incoming().status in ['approved', 'rejected'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'approvedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Rewards Collection
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 4. Claims Collection
    match /claims/{claimId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidClaim(incoming()) && (
        (incoming().userId == request.auth.uid && incoming().status == 'pending') || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() && isValidClaim(incoming()) && (
          // Admin completes pending claim
          existing().status == 'pending' && 
          incoming().status == 'completed' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if isAdmin();
    }

    // 5. Feedbacks Collection
    match /feedbacks/{feedbackId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidFeedback(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 6. Schedules Collection
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 7. Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) && 
         incoming().isRead == true) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
